TELEGRAM_TOKEN=123456789:ABCdef...

# Чат отдела и ветка (топик) для заявок. Получить: добавить бота в группу,
# в нужной ветке дать команду /id.
DEPT_CHAT_ID=
DEPT_THREAD_ID=

# URL витрины на GitHub Pages (Mini App с карточками кейсов).
WEBAPP_URL=

# Файл базы заявок (SQLite), создаётся автоматически.
DB_FILE=requests.sqlite3

# Кейсы (тексты + картинки карточек) — таблица `cases` в Supabase, тот же
# источник читает Mini App (docs/index.html). anon-ключ публичный (read-only
# по Row Level Security), не секрет — но всё равно берётся из .env, не хардкодится.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Pyrus. Ключ берётся в Pyrus → Авторизация → Секретный API ключ; логин —
# почта того аккаунта, которому ключ выдан (в другом аккаунте он не работает).
# Пустые значения = интеграции нет: заявки живут только в чате отдела и в
# своей базе, поведение бота прежнее.
PYRUS_LOGIN=
PYRUS_SECURITY_KEY=
# Форма, в реестр которой падают заявки. Формы создаются только в интерфейсе
# Pyrus, API их не умеет. Пока пусто — бот создаёт обычную задачу с текстом.
PYRUS_FORM_ID=
