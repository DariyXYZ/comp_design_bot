# Локальный запуск через scripts/run-dev.ps1. Скопировать в server/.env.dev и заполнить.
# Скрипт читает файл сам; приложение получает только переменные окружения.

# ТЕСТОВЫЙ бот из @BotFather, не рабочий: у Telegram один получатель обновлений на токен,
# рабочий бот при этом продолжает работать на Python.
TELEGRAM_TOKEN=
SESSION_SECRET=local-dev-secret
TELEGRAM_WEBHOOK_SECRET=local-dev-hook

# Тестовая группа с ботом (ветка не обязательна). Узнать: /id в группе.
DEPT_CHAT_ID=
DEPT_THREAD_ID=

# Pyrus — те же, что в bot/.env. Задачи создаются на настоящей доске 2457342.
PYRUS_LOGIN=
PYRUS_SECURITY_KEY=
PYRUS_FORM_ID=2457342

ASPNETCORE_URLS=http://127.0.0.1:5089
