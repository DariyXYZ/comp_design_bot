# Supabase: карточки тем (таблица `cases`) — тот же источник, что у бота.
# Читает их серверный роут /api/topics, поэтому префикс NEXT_PUBLIC_ не
# нужен: ключ не должен попадать в браузерный бандл.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Пусто = API на этом же домене (так на Vercel). Полный адрес нужен только
# если приложение раздаётся отдельно от API.
NEXT_PUBLIC_API_BASE=

# Подпапка, если приложение раздаётся не из корня домена (project pages).
NEXT_PUBLIC_BASE_PATH=

# --- серверные, в бандл не попадают ---

# Токен бота: им подписаны данные запуска Mini App и наши токены сессии.
TELEGRAM_TOKEN=

# Pyrus: ключ выдан конкретному логину и работает только с ним.
# PYRUS_FORM_ID — форма «Заявка в отдел вычислительного проектирования».
PYRUS_LOGIN=
PYRUS_SECURITY_KEY=
PYRUS_FORM_ID=
